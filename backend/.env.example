PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrismart_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# ─── Weather (OpenWeatherMap) ──────────────────────────────────────────────────
# Get a FREE key at: https://openweathermap.org/api → "Current Weather Data" plan
# Leave empty to use built-in fallback data (24°C Sunny Beni Mellal)
WEATHER_API_KEY=

# ─── AI (OpenAI) ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
AI_MODEL=gpt-4o
