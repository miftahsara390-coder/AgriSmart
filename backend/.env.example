# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrismart_db?schema=public"

# Authentication & JWT Secrets
JWT_SECRET="your_jwt_access_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Origins
CORS_ORIGIN="*"

# AI Agent & OpenAI API (for future RAG integration)
AI_API_KEY="your_openai_or_gemini_api_key_here"
