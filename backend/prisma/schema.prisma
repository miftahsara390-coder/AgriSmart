// AgriSmart Prisma Schema
// Database configuration for PostgreSQL with pgvector support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- USER & AUTH ----------------

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  farmName     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  crops         Crop[]
  tasks         Task[]
  conversations Conversation[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------- CROPS ----------------

enum CropStatus {
  PLANTED
  GROWING
  HARVESTED
  FAILED
}

model Crop {
  id                  String     @id @default(uuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  type                String?    // e.g. Cereale, Legumineuse, Fruitier
  variety             String?    // Specific variety
  plantingDate        DateTime
  expectedHarvestDate DateTime?
  area                Float?     // In hectares
  location            String?    // Parcel name or coordinates
  notes               String?    @db.Text
  status              CropStatus @default(PLANTED)
  currentStage        String?    // e.g. Germination, Floraison, Maturation
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  tasks Task[]

  @@index([userId])
  @@map("crops")
}

// ---------------- AGRICULTURAL TASKS ----------------

enum TaskType {
  WATERING
  PLANTING
  FERTILIZATION
  TREATMENT
  INSPECTION
  HARVEST
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropId      String?
  crop        Crop?         @relation(fields: [cropId], references: [id], onDelete: SetNull)
  type        TaskType      @default(WATERING)
  priority    TaskPriority  @default(MEDIUM)
  status      TaskStatus    @default(PENDING)
  title       String
  description String?       @db.Text
  date        DateTime      // Scheduled task date
  time        String?       // Optional scheduled time e.g. "08:30"
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([cropId])
  @@map("tasks")
}

// ---------------- AI CONVERSATIONS & MESSAGES ----------------

enum MessageSender {
  USER
  ASSISTANT
}

model Conversation {
  id        String    @id @default(uuid())
  title     String    @default("Nouvelle consultation")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  content        String        @db.Text
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ---------------- RAG KNOWLEDGE BASE & EMBEDDINGS ----------------

model Document {
  id        String      @id @default(uuid())
  title     String
  source    String?     // Source reference or URL
  content   String      @db.Text
  metadata  Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  embeddings Embedding[]

  @@map("documents")
}

model Embedding {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String   @db.Text
  // In PostgreSQL with pgvector, an Unsupported("vector(1536)") can be used via custom SQL migrations
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@map("embeddings")
}
